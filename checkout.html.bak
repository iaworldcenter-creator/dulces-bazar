        {sku:'BTN-013',nombre:'Doritos Nacho Sabritas (150g)',imagen:'assets/img/91fL315hJIL._SL1500_.webp',precio:'38',precio_original:'51',descuento:'25% OFF',existencias:'12',categoria:'botanas-snacks',descripcion:'Producto premium garantizado de la categoría Botanas y Snacks. Disfruta de la mejor calidad, servicio y garantía en nuestro portal.',modelo_caja:'BTN-013',tamano_altavoz:'N/A',caracteristicas:'Garantía oficial del ecosistema, empaque de seguridad y entrega inmediata.'},
        {sku:'BTN-014',nombre:'Chips Sal de Mar Barcel (100g)',imagen:'assets/img/91fL315hJIL._SL1500_.webp',precio:'34',precio_original:'45',descuento:'25% OFF',existencias:'12',categoria:'botanas-snacks',descripcion:'Producto premium garantizado de la categoría Botanas y Snacks. Disfruta de la mejor calidad, servicio y garantía en nuestro portal.',modelo_caja:'BTN-014',tamano_altavoz:'N/A',caracteristicas:'Garantía oficial del ecosistema, empaque de seguridad y entrega inmediata.'},
        {sku:'BTN-015',nombre:'Cacahuates Hot Nuts Original (100g)',imagen:'assets/img/91fL315hJIL._SL1500_.webp',precio:'24',precio_original:'32',descuento:'25% OFF',existencias:'12',categoria:'botanas-snacks',descripcion:'Producto premium garantizado de la categoría Botanas y Snacks. Disfruta de la mejor calidad, servicio y garantía en nuestro portal.',modelo_caja:'BTN-015',tamano_altavoz:'N/A',caracteristicas:'Garantía oficial del ecosistema, empaque de seguridad y entrega inmediata.'},
        {sku:'BTN-016',nombre:'Ruffles Queso Sabritas (120g)',imagen:'assets/img/91fL315hJIL._SL1500_.webp',precio:'36',precio_original:'48',descuento:'25% OFF',existencias:'12',categoria:'botanas-snacks',descripcion:'Producto premium garantizado de la categoría Botanas y Snacks. Disfruta de la mejor calidad, servicio y garantía en nuestro portal.',modelo_caja:'BTN-016',tamano_altavoz:'N/A',caracteristicas:'Garantía oficial del ecosistema, empaque de seguridad y entrega inmediata.'},
        {sku:'BTN-017',nombre:'Chips Fuego Barcel (100g)',imagen:'assets/img/91fL315hJIL._SL1500_.webp',precio:'34',precio_original:'45',descuento:'25% OFF',existencias:'12',categoria:'botanas-snacks',descripcion:'Producto premium garantizado de la categoría Botanas y Snacks. Disfruta de la mejor calidad, servicio y garantía en nuestro portal.',modelo_caja:'BTN-017',tamano_altavoz:'N/A',caracteristicas:'Garantía oficial del ecosistema, empaque de seguridad y entrega inmediata.'},
        {sku:'BTN-018',nombre:'Cacahuates Hot Nuts Fuego (100g)',imagen:'assets/img/91fL315hJIL._SL1500_.webp',precio:'24',precio_original:'32',descuento:'25% OFF',existencias:'12',categoria:'botanas-snacks',descripcion:'Producto premium garantizado de la categoría Botanas y Snacks. Disfruta de la mejor calidad, servicio y garantía en nuestro portal.',modelo_caja:'BTN-018',tamano_altavoz:'N/A',caracteristicas:'Garantía oficial del ecosistema, empaque de seguridad y entrega inmediata.'},
        {sku:'BTN-019',nombre:'Doritos Flamin Hot Sabritas (150g)',imagen:'assets/img/91fL315hJIL._SL1500_.webp',precio:'38',precio_original:'51',descuento:'25% OFF',existencias:'12',categoria:'botanas-snacks',descripcion:'Producto premium garantizado de la categoría Botanas y Snacks. Disfruta de la mejor calidad, servicio y garantía en nuestro portal.',modelo_caja:'BTN-019',tamano_altavoz:'N/A',caracteristicas:'Garantía oficial del ecosistema, empaque de seguridad y entrega inmediata.'},
        {sku:'BTN-020',nombre:'Chips Chipotle Barcel (100g)',imagen:'assets/img/91fL315hJIL._SL1500_.webp',precio:'34',precio_original:'45',descuento:'25% OFF',existencias:'12',categoria:'botanas-snacks',descripcion:'Producto premium garantizado de la categoría Botanas y Snacks. Disfruta de la mejor calidad, servicio y garantía en nuestro portal.',modelo_caja:'BTN-020',tamano_altavoz:'N/A',caracteristicas:'Garantía oficial del ecosistema, empaque de seguridad y entrega inmediata.'},
    ];

    function getCart() {
        const stored = localStorage.getItem("ecosystem_global_cart");
        return stored ? JSON.parse(stored) : [];
    }
    
    function saveCart(cart) {
        localStorage.setItem("ecosystem_global_cart", JSON.stringify(cart));
        renderCheckout();
    }

    // STEP 1: DELIVERY HANDLERS
    window.saveDelivery = function(event) {
        event.preventDefault();
        const name = document.getElementById("devName").value;
        const phone = document.getElementById("devPhone").value;
        const email = document.getElementById("devEmail").value;
        const street = document.getElementById("devStreet").value;
        const colonia = document.getElementById("devColonia").value;
        const cp = document.getElementById("devCp").value;
        const city = document.getElementById("devCity").value;
        
        const data = { name, phone, email, street, colonia, cp, city };
        localStorage.setItem("user_delivery_address", JSON.stringify(data));
        
        showDeliverySummary();
        unlockPaymentStep();
        renderCheckout();
    };
    
    window.editDelivery = function() {
        document.getElementById("delivery-form").classList.remove("hidden");
        document.getElementById("delivery-summary").classList.add("hidden");
        document.getElementById("delivery-edit-btn").classList.add("hidden");
    };
    
    function showDeliverySummary() {
        const stored = localStorage.getItem("user_delivery_address");
        if (stored) {
            const data = JSON.parse(stored);
            document.getElementById("delivery-form").classList.add("hidden");
            document.getElementById("delivery-summary").classList.remove("hidden");
            document.getElementById("delivery-edit-btn").classList.remove("hidden");
            
            document.getElementById("sum-name").innerText = data.name;
            document.getElementById("sum-phone-email").innerText = `📞 ${data.phone}  |  ✉️ ${data.email}`;
            document.getElementById("sum-address").innerText = `📍 ${data.street}, Col. ${data.colonia}, CP ${data.cp}, ${data.city}`;
        }
    }
    
    function unlockPaymentStep() {
        const stepCard = document.getElementById("step-payment-card");
        const badge = document.getElementById("step-payment-badge");
        const options = document.getElementById("payment-options");
        
        if (stepCard && badge && options) {
            stepCard.classList.remove("opacity-60");
            badge.classList.remove("bg-slate-800", "text-slate-400");
            badge.classList.add("bg-cyan-500", "text-slate-950");
            options.classList.remove("hidden");
        }
    }

    // STEP 2: PAYMENT METHOD HANDLERS
    window.selectPaymentMethod = function(method) {
        localStorage.setItem("user_payment_method", method);
        showPaymentSummary();
    };
    
    window.toggleCardForm = function() {
        document.getElementById("card-payment-form").classList.remove("hidden");
    };
    
    window.saveCardDetails = function(event) {
        event.preventDefault();
        const name = document.getElementById("cardName").value;
        const num = document.getElementById("cardNum").value;
        const last4 = num.replace(/\\s/g, '').slice(-4) || "4152";
        
        const type = num.startsWith("5") ? "Mastercard" : "Visa";
        localStorage.setItem("user_payment_method", `${type} (**** ${last4})`);
        
        document.getElementById("card-payment-form").classList.add("hidden");
        showPaymentSummary();
    };
    
    window.editPayment = function() {
        document.getElementById("payment-options").classList.remove("hidden");
        document.getElementById("payment-summary").classList.add("hidden");
        document.getElementById("payment-edit-btn").classList.add("hidden");
    };
    
    function showPaymentSummary() {
        const method = localStorage.getItem("user_payment_method");
        if (method) {
            document.getElementById("payment-options").classList.add("hidden");
            document.getElementById("payment-summary").classList.remove("hidden");
            document.getElementById("payment-edit-btn").classList.remove("hidden");
            
            document.getElementById("payment-summary").innerHTML = `
                <div class="flex items-center gap-2 bg-slate-950/60 p-4 rounded-xl border border-slate-800">
                    <i class="fa-solid fa-circle-check text-emerald-400 text-lg"></i>
                    <div>
                        <span class="text-[10px] text-slate-500 uppercase tracking-wider block font-bold">Forma Registrada</span>
                        <span class="text-white font-bold">${method}</span>
                    </div>
                </div>
            `;
        }
    }

    // STEP 3: RENDER CHECKOUT CART
    window.changeQty = function(sku, amount) {
        let cart = getCart();
        const item = cart.find(i => i.sku === sku);
        if (item) {
            item.quantity += amount;
            if (item.quantity < 0) item.quantity = 0;
            if (item.quantity === 0) {
                cart = cart.filter(i => i.sku !== sku);
            }
        }
        saveCart(cart);
    };
    
    window.deleteItem = function(sku) {
        let cart = getCart();
        cart = cart.filter(i => i.sku !== sku);
        saveCart(cart);
    };
    
    window.renderCheckout = function() {
        const container = document.getElementById("checkout-cart-items");
        const subtotalDisp = document.getElementById("co-subtotal");
        const wholesaleRow = document.getElementById("co-wholesale-row");
        const wholesaleDiscDisp = document.getElementById("co-wholesale-disc");
        const shippingDisp = document.getElementById("co-shipping");
        const cashbackRow = document.getElementById("co-cashback-row");
        const totalDisp = document.getElementById("co-total");
        
        if (!container) return;
        
        const cart = getCart();
        container.innerHTML = "";
        
        let subtotal = 0;
        let totalItemsQty = 0;
        
        cart.forEach(item => {
            const sub = parseFloat(item.precio) * item.quantity;
            subtotal += sub;
            totalItemsQty += item.quantity;
            
            let imgUrl = item.imagen;
            if (imgUrl && imgUrl.startsWith('assets/img')) {
                imgUrl = './' + imgUrl;
            }
            
            let minusButtonHtml = `<button onclick="changeQty('${item.sku}', -1)" class="w-5 h-5 rounded bg-slate-800 text-slate-400 hover:text-white transition flex items-center justify-center font-bold text-xs cursor-pointer">-</button>`;
            if (item.quantity === 1) {
                minusButtonHtml = `<button onclick="changeQty('${item.sku}', -1)" class="w-5 h-5 rounded bg-red-655 text-white hover:bg-red-600 transition flex items-center justify-center text-[10px] cursor-pointer" title="Eliminar"><i class="fa-solid fa-trash-can"></i></button>`;
            }
            
            const div = document.createElement("div");
            div.className = "flex items-center justify-between gap-3 bg-slate-950/40 p-2.5 rounded-xl border border-slate-850";
            div.innerHTML = `
                <div class="flex items-center gap-2.5 min-w-0 flex-1">
                    <img src="${imgUrl}" class="w-8 h-8 object-contain bg-white rounded p-0.5 shrink-0" />
                    <div class="min-w-0 flex-1">
                        <span class="text-white font-bold block truncate text-xs">${item.nombre}</span>
                        <span class="text-[9px] font-mono text-slate-500 uppercase">${item.sku}</span>
                    </div>
                </div>
                <div class="flex items-center gap-2.5 shrink-0">
                    <div class="flex items-center gap-1 bg-slate-900 border border-slate-800 rounded p-0.5">
                        ${minusButtonHtml}
                        <span class="text-white font-black text-xs w-4 text-center">${item.quantity}</span>
                        <button onclick="changeQty('${item.sku}', 1)" class="w-5 h-5 rounded bg-slate-800 text-slate-400 hover:text-white transition flex items-center justify-center font-bold text-xs cursor-pointer">+</button>
                    </div>
                    <span class="text-cyan-400 font-bold min-w-[70px] text-right">$${sub.toFixed(2)} MXN</span>
                    <button onclick="deleteItem('${item.sku}')" class="text-slate-500 hover:text-red-500 text-xs cursor-pointer shrink-0 transition"><i class="fa-solid fa-trash-can"></i></button>
                </div>
            `;
            container.appendChild(div);
        });
        
        subtotalDisp.innerText = `$${subtotal.toFixed(2)} MXN`;
        
        // Wholesale check
        let wholesaleDiscount = 0;
        if (totalItemsQty >= 10) {
            wholesaleDiscount = subtotal * 0.15;
            wholesaleRow.classList.remove("hidden");
            wholesaleDiscDisp.innerText = `-$${wholesaleDiscount.toFixed(2)} MXN`;
        } else {
            wholesaleRow.classList.add("hidden");
        }
        
        // Shipping check
        const baseSub = subtotal - wholesaleDiscount;
        const shippingFee = (baseSub >= 1500 || subtotal === 0) ? 0 : 49;
        shippingDisp.innerText = shippingFee === 0 ? "GRATIS" : `$${shippingFee.toFixed(2)} MXN`;
        
        // Cashback check
        const storedAddress = localStorage.getItem("user_delivery_address");
        let hasRegister = false;
        if (storedAddress) {
            const addr = JSON.parse(storedAddress);
            if (addr.email && addr.phone) {
                hasRegister = true;
            }
        }
        
        let cashbackVal = 0;
        if (hasRegister) {
            cashbackVal = baseSub * 0.05;
            cashbackRow.innerHTML = `
                <div class="flex justify-between text-emerald-400 font-black">
                    <span>Cashback 5% Aplicado:</span>
                    <span>-$${cashbackVal.toFixed(2)} MXN</span>
                </div>
                <span class="text-[9px] text-emerald-500 font-semibold leading-tight">✓ Recompensa activa. Saldo descontado del total a pagar.</span>
            `;
        } else {
            cashbackRow.innerHTML = `
                <div class="flex justify-between text-slate-500 font-bold">
                    <span>Cashback Acumulable:</span>
                    <span>$0.00 MXN</span>
                </div>
                <span class="text-[9px] text-amber-500 font-semibold leading-tight">⚠️ Sin registro no aplica cashback. Completa el Paso 1 para activar tu 5%.</span>
            `;
        }
        
        const totalCost = Math.max(0, baseSub - cashbackVal + shippingFee);
        totalDisp.innerText = `$${totalCost.toFixed(2)} MXN`;
    };

    // FINALIZE PURCHASE
    window.finalizePurchase = function() {
        const address = localStorage.getItem("user_delivery_address");
        const method = localStorage.getItem("user_payment_method");
        const cart = getCart();
        
        if (cart.length === 0) {
            alert("⚠️ El carrito de compras está vacío.");
            return;
        }
        if (!address) {
            alert("⚠️ Registra el Domicilio de Entrega (Paso 1) antes de continuar.");
            return;
        }
        if (!method) {
            alert("⚠️ Selecciona un Método de Pago (Paso 2) antes de continuar.");
            return;
        }
        
        // Create order history item
        const orderId = "EC-" + Math.floor(1000 + Math.random() * 9000);
        const dateStr = "Hoy, " + new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        
        const newOrder = {
            orderId: orderId,
            date: dateStr,
            status: "Preparando",
            deliveryTime: "Listo para entrega en 30 min",
            items: cart
        };
        
        let history = [];
        try {
            const stored = localStorage.getItem("user_purchases_history");
            if (stored) history = JSON.parse(stored);
        } catch(e) {}
        
        history.unshift(newOrder);
        localStorage.setItem("user_purchases_history", JSON.stringify(history));
        
        // Clear cart
        localStorage.setItem("ecosystem_global_cart", JSON.stringify([]));
        
        alert(`🎉 ¡COMPRA COMPLETADA CON ÉXITO!\\n\\nPedido #${orderId} registrado.\\nForma de Pago: ${method}\\n\\nEl repartidor llegará en menos de 30 minutos.`);
        window.location.href = "index.html";
    };

    // CHATBOT LOGIC
    window.toggleChatbot = function() {
        const win = document.getElementById("chatbot-window");
        if (win) win.classList.toggle("hidden");
    };
    
    window.handleChatKeyPress = function(event) {
        if (event.key === "Enter") enviarMensajeChatbot();
    };
    
    window.enviarMensajeChatbot = function() {
        const input = document.getElementById("chatInput");
        const messages = document.getElementById("chat-messages");
        if (!input || !messages || !input.value.trim()) return;
        
        const txt = input.value.trim();
        input.value = "";
        
        const uDiv = document.createElement("div");
        uDiv.className = "bg-cyan-500/10 border border-cyan-500/20 p-2.5 rounded-2xl text-slate-200 self-end max-w-[85%]";
        uDiv.innerText = txt;
        messages.appendChild(uDiv);
        messages.scrollTop = messages.scrollHeight;
        
        setTimeout(() => {
            let resp = "Hola, estoy para ayudarte en el proceso de pago. Asegúrate de registrar tu dirección en el Paso 1 para activar el cashback.";
            const low = txt.toLowerCase();
            if (low.includes("envio") || low.includes("entrega") || low.includes("costo")) {
                resp = "El costo de envío local es de $49.00 MXN. ¡Consigues Envío GRATIS si tu compra supera los $1,500.00 MXN!";
            } else if (low.includes("cashback") || low.includes("recompensa") || low.includes("descuento")) {
                resp = "Ofrecemos un 5% de cashback sobre el total de tu compra, descontándose de inmediato si tienes registrada tu dirección, teléfono y correo.";
            } else if (low.includes("mayoreo") || low.includes("mayorista")) {
                resp = "¡Sí! Si compras 10 o más artículos en total, obtendrás un descuento del 15% automático en tu subtotal.";
            }
            
            const bDiv = document.createElement("div");
            bDiv.className = "bg-slate-950 border border-slate-800 p-2.5 rounded-2xl text-slate-300 self-start max-w-[85%]";
            bDiv.innerText = resp;
            messages.appendChild(bDiv);
            messages.scrollTop = messages.scrollHeight;
        }, 600);
    };

    document.addEventListener("DOMContentLoaded", () => {
        showDeliverySummary();
        const address = localStorage.getItem("user_delivery_address");
        if (address) {
            unlockPaymentStep();
            showPaymentSummary();
        }
        renderCheckout();
    });
</script>

</body>
</html>
